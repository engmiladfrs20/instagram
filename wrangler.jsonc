{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instaflow-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "STATE_KV",
      "id": "c533e2d168394c719f2eab35af597e23"
    }
  ],
  "vars": {
    "META_WEBHOOK_VERIFY_TOKEN": "instaflow_secret_verify_token_2026"
  }
}
