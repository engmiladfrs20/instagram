{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instaflow-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "STATE_KV",
      "id": "c533e2d168394c719f2eab35af597e23"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instaflow-db",
      "database_id": "b8047d26-e758-44bd-a016-068c9839892f",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "META_WEBHOOK_VERIFY_TOKEN": "instaflow_secret_verify_token_2026",
    "APP_ORIGIN": "https://instaflow-worker.m-farokhi2729.workers.dev"
  }
}
